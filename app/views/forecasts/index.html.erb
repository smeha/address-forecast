<p style="color: green"><%= notice %></p>

<%= link_to "Search/Cache New Forecast", new_forecast_path %>

<h2>Recently Cached Forecasts (within 30 minutes)</h2>
<div id="fresh_forecasts">
  <% fresh = @forecasts.select(&:fresh?) %>
  <% if fresh.empty? %>
    <p>No recently cached forecasts.</p>
  <% else %>
    <% fresh.each do |forecast| %>
      <p>ZIP: <%= forecast.zip_code %> | Updated at: <%= forecast.updated_at.localtime %> <%= link_to "View", forecast %></p>
    <% end %>
  <% end %>
</div>

<h2>All Cached Forecasts</h2>
<div id="all_forecasts">
  <% if @forecasts.empty? %>
    <p>No cached forecasts.</p>
  <% else %>
    <% @forecasts.each do |forecast| %>
      <p>ZIP: <%= forecast.zip_code %> | Updated at: <%= forecast.updated_at.localtime %> <%= link_to "View", forecast %></p>
    <% end %>
  <% end %>
</div>
